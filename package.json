{
  "name": "nfl-pulse-erp",
  "version": "0.4.2",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "node -e 'process.exit(0)'",
    "db:generate": "npm run prisma:generate -w @nfl/api",
    "db:migrate": "npm run prisma:migrate -w @nfl/api",
    "db:seed": "npm run prisma:seed -w @nfl/api",
    "demo:seed": "npm run prisma:demo-seed -w @nfl/api",
    "demo:clear": "npm run prisma:demo-clear -w @nfl/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
