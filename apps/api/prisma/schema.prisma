generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum OrderSource {
  MANUAL
  IMPORT
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  active        Boolean        @default(true)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  tasks         Task[]         @relation("TaskOwner")
  ordersCreated Order[]        @relation("OrderCreator")
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model Factory {
  id         String        @id @default(cuid())
  code       String        @unique
  name       String
  active     Boolean       @default(true)
  sections   Section[]
  orders     Order[]
  sequences  JobSequence[]
  maintenanceMachines MaintenanceMachine[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Section {
  id        String    @id @default(cuid())
  factoryId String
  name      String
  code      String
  active    Boolean   @default(true)
  factory   Factory   @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  floors    Floor[]
  @@unique([factoryId, code])
}

model Floor {
  id        String    @id @default(cuid())
  sectionId String
  name      String
  code      String
  active    Boolean   @default(true)
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lines     Line[]
  @@unique([sectionId, code])
}

model Line {
  id             String        @id @default(cuid())
  floorId        String
  code           String
  name           String
  active         Boolean       @default(true)
  effectiveFrom  DateTime      @default(now())
  effectiveTo    DateTime?
  floor          Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  machinePools   MachinePool[]
  @@unique([floorId, code])
}

model MachinePool {
  id          String   @id @default(cuid())
  lineId      String
  name        String
  machineCount Int
  capability  Json?
  active      Boolean  @default(true)
  line        Line     @relation(fields: [lineId], references: [id], onDelete: Cascade)
}


model MaintenanceMachine {
  id            String                    @id @default(cuid())
  factoryId     String
  machineType   String
  normalizedKey String
  totalQty      Int                       @default(0)
  aliases       Json?
  active        Boolean                   @default(true)
  factory       Factory                   @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  dailyRows     MaintenanceDailyMachine[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  @@unique([factoryId, normalizedKey])
}

model MaintenanceDailyMachine {
  id              String             @id @default(cuid())
  machineId       String
  date            DateTime
  factoryTotalQty Int?
  breakdownQty    Int                @default(0)
  rentQty         Int                @default(0)
  utilizedQty     Int                @default(0)
  unusedQty       Int                @default(0)
  workingQty      Int?
  floorUsage      Json?
  remarks         String?
  sourceFileName  String?
  sourceSheet     String?
  machine         MaintenanceMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  @@unique([machineId, date])
  @@index([date])
}

model Buyer {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id             String       @id @default(cuid())
  jobNo          String       @unique
  factoryId      String
  buyerId        String
  merchandiserId String?
  source         OrderSource  @default(MANUAL)
  totalQty       Int
  sourceMetadata Json?
  confirmedAt    DateTime     @default(now())
  factory        Factory      @relation(fields: [factoryId], references: [id])
  buyer          Buyer        @relation(fields: [buyerId], references: [id])
  createdById    String
  createdBy      User         @relation("OrderCreator", fields: [createdById], references: [id])
  styles         Style[]
  tasks          Task[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Style {
  id              String           @id @default(cuid())
  orderId         String
  styleNo         String
  itemDescription String?
  quantity        Int
  collection      String?
  season          String?
  sourceMetadata  Json?
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  breakdowns      StyleBreakdown[]
  purchaseOrders  PurchaseOrder[]
  productionLots ProductionLot[]
  @@unique([orderId, styleNo])
}

model StyleBreakdown {
  id        String @id @default(cuid())
  styleId   String
  color     String
  colorCode String?
  size      String
  qty       Int
  ean       String?
  style     Style  @relation(fields: [styleId], references: [id], onDelete: Cascade)
  @@unique([styleId, color, size])
}

model PurchaseOrder {
  id             String                   @id @default(cuid())
  styleId        String
  poNumber       String
  referenceType  String                   @default("PO")
  totalQty       Int
  ccd            DateTime?
  shipmentDate   DateTime?
  cancelDate     DateTime?
  destination    String?
  market         String?
  sourceMetadata Json?
  style          Style                    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  breakdowns     PurchaseOrderBreakdown[]
  lotAllocations ProductionLotAllocation[]
  @@unique([styleId, poNumber])
}

model PurchaseOrderBreakdown {
  id              String        @id @default(cuid())
  purchaseOrderId String
  color           String
  colorCode       String?
  size            String
  qty             Int
  ean             String?
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  @@unique([purchaseOrderId, color, size])
}


enum ProductionLotStatus {
  DRAFT
  APPROVED
  RELEASED
  CLOSED
  CANCELLED
}

model ProductionLot {
  id              String                  @id @default(cuid())
  styleId         String
  code            String
  name            String?
  shipmentDate    DateTime?
  status          ProductionLotStatus     @default(DRAFT)
  totalQty        Int                     @default(0)
  notes           String?
  sourceMetadata  Json?
  createdByUserId String?
  createdByName   String?
  approvedByName  String?
  approvedAt      DateTime?
  releasedAt      DateTime?
  style           Style                   @relation(fields: [styleId], references: [id], onDelete: Cascade)
  allocations     ProductionLotAllocation[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  @@unique([styleId, code])
  @@index([styleId, status])
  @@index([shipmentDate])
}

model ProductionLotAllocation {
  id              String          @id @default(cuid())
  lotId           String
  purchaseOrderId String
  color           String
  colorCode       String?
  size            String
  qty             Int
  ean             String?
  lot             ProductionLot   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  @@unique([lotId, purchaseOrderId, color, size])
  @@index([purchaseOrderId])
  @@index([lotId])
}

model JobSequence {
  id        String  @id @default(cuid())
  factoryId String
  year      Int
  lastValue Int     @default(0)
  factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  @@unique([factoryId, year])
}

model Task {
  id            String       @id @default(cuid())
  title         String
  module        String
  entityType    String
  entityId      String
  orderId       String?
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ownerUserId   String?
  ownerUser     User?        @relation("TaskOwner", fields: [ownerUserId], references: [id])
  ownerRoleCode String?
  status        TaskStatus   @default(PENDING)
  priority      TaskPriority @default(NORMAL)
  dueAt         DateTime?
  blockedReason String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  @@index([ownerUserId, status])
  @@index([ownerRoleCode, status])
  @@index([module, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}

enum ImportBatchStatus {
  STAGED
  COMMITTED
  ROLLED_BACK
  FAILED
}

enum ImportRowStatus {
  VALID
  ERROR
  COMMITTED
  ROLLED_BACK
}

model ImportBatch {
  id             String            @id @default(cuid())
  moduleSlug     String
  sourceFileName String
  sourceSheet    String
  status         ImportBatchStatus @default(STAGED)
  totalRows      Int               @default(0)
  validRows      Int               @default(0)
  errorRows      Int               @default(0)
  mapping        Json?
  headers        Json?
  committedAt    DateTime?
  rolledBackAt   DateTime?
  rows           ImportRow[]
  projections    ImportProjection[]
  mutations      ImportMutation[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  @@index([moduleSlug, status])
  @@index([createdAt])
}

model ImportRow {
  id             String          @id @default(cuid())
  batchId        String
  rowNumber      Int
  rawData        Json
  normalizedData Json?
  errors         Json?
  status         ImportRowStatus @default(VALID)
  jobNo          String?
  styleNo        String?
  buyer          String?
  batch          ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@index([batchId, status])
  @@index([jobNo])
  @@index([styleNo])
}


model ReferenceValue {
  id            String   @id @default(cuid())
  category      String
  value         String
  normalized    String
  source        String?
  sourceBatchId String?
  metadata      Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([category, normalized])
  @@index([category, active])
}

model ImportProjection {
  id         String      @id @default(cuid())
  batchId    String
  rowId      String?
  moduleSlug String
  entityKey  String
  data       Json
  active     Boolean     @default(true)
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  @@unique([batchId, rowId, moduleSlug])
  @@index([moduleSlug, active])
  @@index([entityKey])
}

model ImportMutation {
  id         String      @id @default(cuid())
  batchId    String
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  @@index([batchId, createdAt])
  @@index([entityType, entityId])
}

model IeTargetEntry {
  id               String   @id @default(cuid())
  date             DateTime
  factoryCode      String   @default("NFL")
  floorCode        String
  sectionCode      String?
  lineCode         String
  jobNo            String
  styleNo          String?
  styleId          String?
  targetType       String   @default("NORMAL")
  sourceMode       String   @default("AUTO")
  smv              Float    @default(0)
  effectiveSmv     Float    @default(0)
  shortFactor      Float    @default(1)
  wipQty           Int      @default(0)
  manpower         Int      @default(0)
  plannedHours     Float    @default(8)
  targetEfficiency Float    @default(0)
  targetPerHour    Int      @default(0)
  finalTarget      Int      @default(0)
  actualOutput     Int      @default(0)
  status           String   @default("DRAFT")
  revision         Int      @default(1)
  remarks          String?
  createdByName    String?
  releasedByName   String?
  releasedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([date, floorCode, lineCode])
  @@index([jobNo, date])
  @@index([status, date])
}

model IeNptRecord {
  id                String   @id @default(cuid())
  date              DateTime
  factoryCode       String   @default("NFL")
  floorCode         String?
  lineCode          String
  recordKind        String   @default("NPT")
  nptType           String?
  totalMinutes      Float    @default(0)
  lostMoney         Float?
  responsiblePerson String?
  ieName            String?
  daySpendMinutes   Float?
  dayProduceMinutes Float?
  processName       String?
  machineType       String?
  waitingMinutes    Float?
  repairMinutes     Float?
  remarks           String?
  sourceFileName    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([date, lineCode])
  @@index([recordKind, date])
  @@index([nptType])
}

model IeQcoRule {
  id            String   @id @default(cuid())
  minSmv        Float
  maxSmv        Float?
  standardMin   Int
  active        Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  label         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([active, effectiveFrom])
}

model IeQcoRecord {
  id                    String   @id @default(cuid())
  date                  DateTime
  factoryCode           String   @default("NFL")
  floorCode             String?
  lineCode              String
  buyer                 String?
  jobNo                 String?
  styleNo               String?
  item                   String?
  smv                    Float   @default(0)
  machineQty             Int     @default(0)
  standardMinutes       Int     @default(0)
  actualMinutes         Float   @default(0)
  lossMinutes           Float   @default(0)
  achievementPct        Float   @default(0)
  actualStartTime       String?
  firstGoodOutputTime   String?
  failureReason         String?
  responsibleDeptPerson String?
  remarks               String?
  sourceFileName        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([date, lineCode])
  @@index([jobNo, date])
}

model MisPerformanceRecord {
  id                     String   @id @default(cuid())
  date                   DateTime
  factoryCode            String   @default("NFL")
  floorCode              String?
  lineCode               String
  jobNo                  String   @default("")
  styleNo                String?
  smv                    Float?
  employee               Float?
  operator               Float?
  helper                 Float?
  finishing              Float?
  normalWorkers          Float?
  normalHours            Float?
  overtimeHours          Float?
  spentMinutes           Float?
  cumulativeSpentMinutes Float?
  targetEfficiencyPct    Float?
  targetPerHour          Float?
  dailyTarget            Float?
  hourlyOutput           Json?
  totalOutput            Float?
  cumulativeOutput       Float?
  efficiencyPct          Float?
  cumulativeEfficiencyPct Float?
  performancePct         Float?
  targetProducedMinutes  Float?
  achievedProducedMinutes Float?
  cumulativeAchievedMinutes Float?
  lostProducedMinutes    Float?
  productivity           Float?
  areaGroup              String?
  remarks                String?
  sourceFileName         String?
  sourceSheet            String?
  extra                  Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  @@unique([date, factoryCode, lineCode, jobNo])
  @@index([date, floorCode, lineCode])
  @@index([jobNo, date])
}

model MisSummarySnapshot {
  id             String   @id @default(cuid())
  date           DateTime
  factoryCode    String   @default("NFL")
  section        String   @default("FACTORY")
  metricKey      String
  metricLabel    String
  value          Float?
  textValue      String?
  unit           String?
  sourceFileName String?
  sourceSheet    String?
  extra          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([date, factoryCode, section, metricKey])
  @@index([date, section])
}

model ResponsibleAssignment {
  id            String   @id @default(cuid())
  factoryCode   String   @default("NFL")
  floorCode     String
  areaCode      String?
  lineCode      String?
  department    String
  role          String
  personName    String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([factoryCode, floorCode, department, active])
  @@index([lineCode, department, active])
}

model KpiManualValue {
  id         String   @id @default(cuid())
  year       Int
  month      Int
  section    String
  kpiKey     String
  kpiName    String
  value      Float?
  textValue  String?
  unit       String?
  floorCode  String   @default("")
  lineCode   String   @default("")
  personName String   @default("")
  remarks    String?
  enteredBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([year, month, section, kpiKey, floorCode, lineCode, personName])
  @@index([year, month, section])
}

model KaizenEntry {
  id               String   @id @default(cuid())
  kaizenNo         String   @unique
  title            String
  category         String?
  employeeName     String?
  department       String?
  section          String?
  floorCode        String?
  lineCode         String?
  beforeText       String?
  afterText        String?
  costBenefit      String?
  technicalBenefit String?
  safetyBenefit    String?
  monthlySaving    Float?
  annualSaving     Float?
  status           String   @default("SUBMITTED")
  implementationDate DateTime?
  sustainCheckDate DateTime?
  spreadTo         Json?
  attachmentUrl    String?
  remarks          String?
  submittedBy      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([status, createdAt])
  @@index([department, createdAt])
}

model IeActualAssignment {
  id                 String   @id @default(cuid())
  date               DateTime
  factoryCode        String   @default("NFL")
  floorCode          String?
  lineCode           String
  jobNo              String   @default("")
  styleNo            String?
  operatorPresent    Int      @default(0)
  helperPresent      Int      @default(0)
  finishingPresent   Int      @default(0)
  totalPresent       Int      @default(0)
  assignedManpower   Int      @default(0)
  actualTarget       Int      @default(0)
  remarks            String?
  sourceFileName     String?
  raw                Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([date, factoryCode, lineCode, jobNo])
  @@index([date, floorCode, lineCode])
}

model IeSkillMatrix {
  id             String   @id @default(cuid())
  employeeId     String?
  employeeName   String
  factoryCode    String   @default("NFL")
  floorCode      String?
  lineCode       String?
  operation      String
  machineType    String?
  skillLevel     Int      @default(1)
  proficiencyPct Float?
  active         Boolean  @default(true)
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([floorCode, lineCode, active])
  @@index([employeeName, active])
}
