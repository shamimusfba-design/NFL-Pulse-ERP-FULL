{
  "name": "@nfl/api",
  "version": "0.4.35",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:demo-seed": "tsx prisma/demo-seed.ts",
    "prisma:demo-clear": "tsx prisma/demo-clear.ts",
    "prisma:reference-seed": "tsx prisma/reference-values-seed.ts",
    "prisma:factory-report-seed": "tsx prisma/factory-report-seed.ts",
    "prisma:master-cleanup": "tsx prisma/master-cleanup.ts",
    "prisma:dyeing-seed": "tsx prisma/dyeing-report-seed.ts",
    "test:merch": "tsx --test src/merch/merch.rules.spec.ts src/merch/merch.flow.spec.ts",
    "test:yk": "tsx --test src/yarn-knit/yk.rules.spec.ts",
    "test:yk:db": "YK_DB_TEST=1 tsx --test src/yarn-knit/yk.db.spec.ts",
    "test:pa": "tsx --test src/planning-approvals/pa.rules.spec.ts",
    "test:pa:db": "PA_DB_TEST=1 tsx --test src/planning-approvals/pa.db.spec.ts",
    "test:dyeing": "tsx --test src/dyeing/dyeing.rules.spec.ts",
    "test:dyeing:db": "DYE_DB_TEST=1 tsx --test src/dyeing/dyeing.db.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.2.5",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pdf-parse": "1.1.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.2.5",
    "@types/node": "^22.18.6",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
