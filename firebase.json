{
  "hosting": {
    "site": "nfl-erp",
    "public": ".firebase/nfl-erp/hosting",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/merchandising",
        "destination": "/merchandising-bulk",
        "type": 301
      },
      {
        "regex": "^/merchandising/(dashboard|order-po|bom-material|costing|production|reports-docs|sample-approval|shipment-closing|styles|ta)(/.*)?$",
        "destination": "/merchandising-bulk",
        "type": 301
      },
      {
        "source": "/modules/merchandising",
        "destination": "/merchandising-bulk",
        "type": 301
      },
      {
        "source": "/modules/sample-merchandising",
        "destination": "/merchandising-sample",
        "type": 301
      }
    ]
  }
}
